  "files": [
    "index.js",
    "codez.js",
    "panel.js",
    "service.js",
    "ui/",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "homepage": "https://github.com/zwenooo/magpie-codez#readme",
  "bugs": {
    "url": "https://github.com/zwenooo/magpie-codez/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zwenooo/magpie-codez.git"
  },
